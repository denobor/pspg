#!/usr/bin/env bash
#
# check — does this pspg still have the wide-table bug?
#
#   ./check              the pspg on PATH
#   ./check /path/pspg   a build you want to test
#
# pspg 5.9.0 aborts with "internal error" on any psql-format table whose
# total width is 63 characters or more. 5.8.16 does not. The fixtures
# here sit either side of that threshold, which is why there are three
# of them: a pass on w62 and a failure on w63 is the bug, while a
# failure on all three is something else.
#
# Exit 0 when the binary renders every fixture: the pin can be dropped.
# Exit 1 when any fixture fails: keep denobor/local/pspg@5.8.16.
#
# pspg needs a terminal, so each run goes through `script` to get a pty
# and is fed a `q` to quit.

set -uo pipefail

PSPG="${1:-pspg}"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

command -v "$PSPG" >/dev/null 2>&1 || [[ -x "$PSPG" ]] || {
    echo "check: no such pspg: $PSPG" >&2
    exit 2
}

echo "pspg:    $("$PSPG" --version 2>&1 | head -1)"
echo "binary:  $(command -v "$PSPG" || echo "$PSPG")"
echo

bad=0
for f in "$HERE"/w*.psql; do
    width=$(awk 'NR==2 {print length($0)}' "$f")
    out=$(printf 'q' | script -q /dev/null "$PSPG" -f "$f" 2>&1 | tr -d '\r')
    if grep -qi "internal error" <<<"$out"; then
        printf '  %-12s width %-4s INTERNAL ERROR\n' "$(basename "$f")" "$width"
        bad=$((bad + 1))
    else
        printf '  %-12s width %-4s renders\n' "$(basename "$f")" "$width"
    fi
done

echo
if [[ $bad -gt 0 ]]; then
    echo "$bad fixture(s) failed. Keep the pin."
    exit 1
fi
echo "All fixtures render. Upstream may be fixed; see README.md before"
echo "dropping denobor/local/pspg@5.8.16."
